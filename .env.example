# Obtain both values at https://my.telegram.org/apps.
API_ID=123456
API_HASH=replace_with_your_32_character_api_hash

# Local session filename (Telegram adds .session).
SESSION_NAME=replytgbot

# Sent as text, or as the photo caption when PHOTO_URL is set.
REPLY_TEXT="Thanks for your message! I will reply when I am available."

# Optional direct, publicly accessible HTTPS media URLs. Leave empty for text only.
PHOTO_URL=
GIF_URL=

# One reply attempt per sender per hour. Must be a positive integer.
COOLDOWN_SECONDS=3600
